{
  "name": "healing-hideaway-kiosk",
  "version": "0.2.0",
  "description": "Healing Hideaway in-office booking kiosk",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:kiosk": "tauri build --config src-tauri/tauri.kiosk.conf.json",
    "release:kiosk": "npm run build:kiosk && mkdir -p ../releases && cp \"../target/release/bundle/rpm/Healing Hideaway-${npm_package_version}-1.x86_64.rpm\" \"../releases/healing-hideaway-kiosk-${npm_package_version}-1.x86_64.rpm\" && ls -l ../releases"
  },
  "private": true,
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
